# docker-compose用の環境変数の雛形。
# cp .env.example .env してから中身を埋める(.envはgit管理しない)。
#
# ここで設定した値は、config/app_local.php の中で env('SMTP_HOST') のように
# 読み出す形にすること(composer create-projectで生成した直後のapp_local.phpは
# 値が直接書かれているので、Docker用に書き換える一手間が必要)。

# MySQLの接続情報。DB_*はapp/cronコンテナ側(config/app_local.phpからenv()で
# 読み出す)、MYSQL_*はmysqlコンテナ自体の初期化用(docker-compose.yml参照)。
# 値は同じものを両方に設定すること。
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dentore
DB_USERNAME=dentore
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 既存の組織メールサーバー(SMTP)の接続情報(要件3.4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 合言葉方式の認証に使う値(要件3.5)
SHARED_PASSWORD=

# CakePHPのセキュリティ用ソルト(セッション等の暗号化に使う)。
# 未設定だと app_local.php の既定値 '__SALT__' になってしまうため必ず埋める。
# 生成例: openssl rand -hex 32
SECURITY_SALT=

# CakePHPのデバッグモード(本番では false にする)
DEBUG=false
